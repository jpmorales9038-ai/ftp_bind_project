+pm() {{ echo INSTALL_FAILED_UPDATE_INCOMPATIBLE; }}
+install_app "{apk}" "{p}/log"''')
+   self.assertEqual(r.returncode,1)
+   log=(p/'log').read_text();self.assertIn('NO se desinstala',log);self.assertNotIn('por stdin',log)
+ def test_preload_second_instance_preserves_temporaries(self):
+  with tempfile.TemporaryDirectory() as d:
+   p=Path(d);(p/'scripts').mkdir();(p/'preload.lock').mkdir();(p/'.preload_list').write_text('keep')
+   common=(ROOT/'module/scripts/common.sh').read_text()+ '\nenter_global_namespace() { return 0; }\n'
+   (p/'scripts/common.sh').write_text(common)
+   (p/'scripts/preload.sh').write_text((ROOT/'module/scripts/preload.sh').read_text())
+   r=self.shell(f'sh "{p}/scripts/preload.sh"')
+   self.assertEqual(r.returncode,0,r.stderr);self.assertEqual((p/'.preload_list').read_text(),'keep')
+ def test_clear_cache_refuses_recovery_metadata(self):
+  with tempfile.TemporaryDirectory() as d:
+   p=Path(d);(p/'scripts').mkdir();(p/'cache/vfsMeta').mkdir(parents=True)
+   (p/'cache/vfsMeta/pending').write_text('must survive')
+   common=(ROOT/'module/scripts/common.sh').read_text()+'\nenter_global_namespace() { return 0; }\nis_mount_at() { return 1; }\n'
+   (p/'scripts/common.sh').write_text(common);(p/'scripts/clear_cache.sh').write_text((ROOT/'module/scripts/clear_cache.sh').read_text())
+   r=self.shell(f'sh "{p}/scripts/clear_cache.sh"')
+   self.assertEqual(r.returncode,1,r.stderr);self.assertTrue((p/'cache/vfsMeta/pending').exists())
+ def test_unmount_pending_and_empty_queue(self):
+  for pending in [0,1]:
+   with self.subTest(pending=pending), tempfile.TemporaryDirectory() as d:
+    p=Path(d);(p/'scripts').mkdir()
+    (p/'status.json').write_text('{"mounted":true,"remote":"remote","target":"/sdcard/FTP"}')
+    (p/'calls').write_text('')
+    common=(ROOT/'module/scripts/common.sh').read_text()+f"""
+enter_global_namespace() {{ return 0; }}
+is_mount_at() {{ [ ! -f "$MODDIR/detached" ] && [ "$1" = /data/local/tmp/rclone_ftp ]; }}
+setup_rc() {{ return 0; }}
+rc_call() {{ printf '%s\\n' '{{"uploadsQueued": {pending}, "uploadsInProgress": 0, "erroredFiles": 0, "inUse": 0}}' | sed 's/, /,\\n/g; s/}}/\\n}}/g'; }}
+sleep() {{ return 0; }}
+pgrep() {{ return 1; }}
+stat() {{ echo 123; }}
+umount() {{ echo "$1" >> "$MODDIR/calls"; [ "$1" = /data/local/tmp/rclone_ftp ] && touch "$MODDIR/detached"; return 0; }}
+"""
+    (p/'scripts/common.sh').write_text(common);(p/'scripts/env.sh').write_text('true\n')
+    (p/'scripts/unmount.sh').write_text((ROOT/'module/scripts/unmount.sh').read_text())
+    result=self.shell(f'sh "{p}/scripts/unmount.sh"')
+    self.assertEqual(result.returncode,1 if pending else 0,result.stdout+result.stderr)
+    if pending:self.assertEqual((p/'calls').read_text(),'')
+    else:self.assertIn('"mounted":false',(p/'status.json').read_text())
+ def test_no_force_or_broad_system_overlay(self):
+  unmount=(ROOT/'module/scripts/unmount.sh').read_text()
+  self.assertNotIn('umount -l',unmount);self.assertNotIn('pkill -f',unmount)
+  self.assertNotIn('mount -t overlay',(ROOT/'module/scripts/env.sh').read_text())
+  self.assertIn('rc_call vfs/stats',unmount)
+ def test_benchmark_uses_unique_directory(self):
+  s=(ROOT/'module/scripts/perf_test.sh').read_text()
+  self.assertIn('TDIR="$T/.rclone-bind-test-$$"',s)
+  self.assertIn('mkdir "$TDIR"',s);self.assertNotIn('mkdir -p "$TDIR"',s)
+ def test_app_boundary_guards(self):
+  s=(ROOT/'app/src/main/java/com/rclonebind/app/BindViewModel.kt').read_text()
+  self.assertIn('if (stopped.success) RootShell.mount() else stopped',s)
+  self.assertIn('finally {\n            busy = false',s)
+  s=(ROOT/'app/src/main/java/com/rclonebind/app/root/RootShell.kt').read_text()
+  self.assertIn('v.any { it.isISOControl() }',s)
+  self.assertIn('fun status(): Result = run("sh ${ModulePaths.SCRIPTS}/status.sh")',s)
+  self.assertIn('obscure -',s)
+if __name__=='__main__':unittest.main(verbosity=2)
