+#!/usr/bin/env python3
+"""Host-only regression tests. Never mount, install, or execute supplied binaries."""
+import os, subprocess, tempfile, unittest
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[1]
+class ReviewTests(unittest.TestCase):
+ def shell(self, code, env=None):
+  return subprocess.run(['dash','-c',code],text=True,capture_output=True,env=env,timeout=15)
+ def test_all_shell_syntax(self):
+  for p in sorted((ROOT/'module').rglob('*.sh')):
+   with self.subTest(file=p.name):
+    r=subprocess.run(['dash','-n',str(p)],capture_output=True,text=True)
+    self.assertEqual(r.returncode,0,r.stderr)
+ def test_target_validation(self):
+  with tempfile.TemporaryDirectory() as d:
+   for path,expected in [('/sdcard/FTP',0),('/sdcard/Game Assets',0),('/data/media/0/test',0),('/system/etc',1),('/',1),('/sdcard/../data',1),('/sdcard/a"b',1),('/sdcard/a\\b',1),('/sdcard/a\nb',1),('/sdcard//test',1),('/sdcard/./test',1)]:
+    with self.subTest(path=path):
+     env=dict(os.environ,TEST_PATH=path,TEST_MOD=d)
+     r=self.shell(f'MODDIR="$TEST_MOD"; . "{ROOT}/module/scripts/common.sh"; valid_target "$TEST_PATH"',env)
+     self.assertEqual(r.returncode,expected,r.stdout+r.stderr)
+ def test_timeout_and_success(self):
+  with tempfile.TemporaryDirectory() as d:
+   base=f'MODDIR="{d}"; . "{ROOT}/module/scripts/common.sh"; '
+   self.assertEqual(self.shell(base+'run_timeout 2 sh -c "exit 7"').returncode,7)
+   self.assertEqual(self.shell(base+'run_timeout 1 sleep 5').returncode,124)
+ def test_operation_lock_exclusion(self):
+  with tempfile.TemporaryDirectory() as d:
+   Path(d,'operation.lock').mkdir()
+   r=self.shell(f'MODDIR="{d}"; . "{ROOT}/module/scripts/common.sh"; acquire_operation_lock')
+   self.assertEqual(r.returncode,1); self.assertTrue(Path(d,'operation.lock').exists())
+ def test_lock_cleanup(self):
+  with tempfile.TemporaryDirectory() as d:
+   r=self.shell(f'MODDIR="{d}"; . "{ROOT}/module/scripts/common.sh"; acquire_operation_lock; exit 0')
+   self.assertEqual(r.returncode,0); self.assertFalse(Path(d,'operation.lock').exists())
+ def test_rc_secret_permissions_and_reuse(self):
+  with tempfile.TemporaryDirectory() as d:
+   base=f'MODDIR="{d}"; . "{ROOT}/module/scripts/common.sh"; setup_rc'
+   self.assertEqual(self.shell(base).returncode,0)
+   p=Path(d,'config/rc_secret'); first=p.read_text()
+   self.assertEqual(len(first),64);self.assertEqual(p.stat().st_mode & 0o777,0o600)
+   self.assertEqual(self.shell(base).returncode,0);self.assertEqual(p.read_text(),first)
+ def test_remote_key_and_numeric_ranges(self):
+  with tempfile.TemporaryDirectory() as d:
+   conf=Path(d,'test.conf'); conf.write_bytes(b'[a.b]\r\ntype = s3\r\nbind_path = bucket/dir\r\n[aXb]\r\ntype = ftp\r\n')
+   base=f'MODDIR="{d}"; RCLONE_CONF="{conf}"; . "{ROOT}/module/scripts/perf_opts.sh"; '
+   self.assertEqual(self.shell(base+'remote_type a.b').stdout.strip(),'s3')
+   self.assertEqual(self.shell(base+'remote_root a.b').stdout.strip(),'bucket/dir')
+   for v,want in [('0004','4'),('999999999999999','2'),('x','2'),('0','2'),('17','2')]:
+    self.assertEqual(self.shell(base+f'num_in_range {v} 1 16 2').stdout.strip(),want)
+ def test_performance_matrix_with_fake_rclone(self):
+  with tempfile.TemporaryDirectory() as d:
+   mod=Path(d);(mod/'config').mkdir();(mod/'bin').mkdir()
+   fake=mod/'bin/rclone';fake.write_text('#!/bin/sh\nprintf "%s\\n" "--vfs-read-chunk-streams --s3-upload-concurrency --s3-chunk-size --s3-upload-cutoff --s3-no-head --s3-no-head-object --use-server-modtime --s3-directory-markers"\n');fake.chmod(0o700)
+   for typ in ['ftp','drive','s3']:
+    for mode in ['balanced','max']:
+     with self.subTest(type=typ,mode=mode):
+      (mod/'config/perf').write_text(mode);(mod/'config/rclone.conf').write_text(f'[remote]\ntype = {typ}\nendpoint = https://host.oraclecloud.com\n')
+      r=self.shell(f'MODDIR="{mod}"; RCLONE_CONF="$MODDIR/config/rclone.conf"; ACTIVE=remote; . "{ROOT}/module/scripts/perf_opts.sh"; compute_mount_opts; echo "$MOUNT_OPTS"')
+      self.assertEqual(r.returncode,0,r.stderr)
+      self.assertIn('--vfs-cache-mode writes' if typ=='ftp' and mode=='balanced' else '--vfs-cache-mode full',r.stdout)
+      self.assertIn('--buffer-size 16M' if mode=='max' else '--buffer-size 8M',r.stdout)
+      if typ=='s3':self.assertIn('--s3-directory-markers',r.stdout)
+ def test_signature_conflict_never_uninstalls(self):
+  with tempfile.TemporaryDirectory() as d:
+   p=Path(d);apk=p/'app.apk';apk.write_bytes(b'mock')
+   r=self.shell(f''' . "{ROOT}/module/scripts/install_app.sh"
